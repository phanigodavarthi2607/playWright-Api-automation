{
  "name": "agent-playwright-framework",
  "version": "1.0.0",
  "description": "AI Agent-driven Playwright test automation framework with Jira integration, auto-healing, and multi-platform data validation",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "test": "npx playwright test",
    "test:ui": "npx playwright test tests/ui/",
    "test:api": "npx playwright test tests/api/",
    "test:data": "npx playwright test tests/data/",
    "test:generated": "npx playwright test tests/generated/",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug",
    "report": "npx playwright show-report reports/html",
    "orchestrate": "node src/agents/orchestrator.js",
    "jira:fetch": "node src/agents/jira-agent/index.js",
    "jira:sync": "node src/agents/test-cases-agent/index.js",
    "generate:tests": "node src/agents/coding-agent/index.js",
    "analyze": "node src/agents/test-analysis-agent/index.js",
    "heal": "node src/agents/auto-healing-agent/index.js",
    "compare:data": "node src/agents/data-comparison-agent/index.js",
    "snapshot:locators": "node src/agents/auto-healing-agent/snapshot.js"
  },
  "dependencies": {
    "@playwright/test": "^1.48.0",
    "axios": "^1.7.0",
    "chalk": "^5.3.0",
    "dotenv": "^16.4.0",
    "snowflake-sdk": "^1.11.0",
    "databricks-sql-nodejs": "^1.8.0",
    "winston": "^3.14.0",
    "handlebars": "^4.7.8",
    "diff": "^7.0.0",
    "csv-parse": "^5.5.0",
    "json-diff": "^1.0.6"
  },
  "devDependencies": {
    "eslint": "^9.0.0"
  }
}
