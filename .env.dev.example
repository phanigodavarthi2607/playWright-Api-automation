# Environment: dev
# Copy this file to .env.dev and fill in your dev environment values

TEST_ENV=dev

# Jira Configuration
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=PROJ
JIRA_AUTO_FIELD=customfield_10100

# Snowflake Configuration (Dev)
SNOWFLAKE_ACCOUNT=your-dev-account
SNOWFLAKE_USERNAME=your-dev-username
SNOWFLAKE_PASSWORD=your-dev-password
SNOWFLAKE_DATABASE=DEV_DATABASE
SNOWFLAKE_SCHEMA=DEV_SCHEMA
SNOWFLAKE_WAREHOUSE=DEV_WAREHOUSE
SNOWFLAKE_ROLE=DEV_ROLE

# Databricks Configuration (Dev)
DATABRICKS_HOST=https://dev-workspace.cloud.databricks.com
DATABRICKS_TOKEN=your-dev-databricks-token
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/dev-warehouse-id

# Application Under Test (Dev)
APP_BASE_URL=https://dev.your-app.com
APP_API_BASE_URL=https://dev-api.your-app.com
APP_USERNAME=dev-test-user
APP_PASSWORD=dev-test-password

# Agent Configuration
AGENT_LOG_LEVEL=debug
AGENT_MAX_HEAL_ATTEMPTS=3
AGENT_LOCATOR_SIMILARITY_THRESHOLD=0.7
AGENT_AUTO_COMMIT_FIXES=false

# Reporting
REPORT_OUTPUT_DIR=./reports/dev
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=true
