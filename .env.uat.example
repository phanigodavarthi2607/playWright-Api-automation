# Environment: uat
# Copy this file to .env.uat and fill in your UAT environment values

TEST_ENV=uat

# Jira Configuration
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=PROJ
JIRA_AUTO_FIELD=customfield_10100

# Snowflake Configuration (UAT)
SNOWFLAKE_ACCOUNT=your-uat-account
SNOWFLAKE_USERNAME=your-uat-username
SNOWFLAKE_PASSWORD=your-uat-password
SNOWFLAKE_DATABASE=UAT_DATABASE
SNOWFLAKE_SCHEMA=UAT_SCHEMA
SNOWFLAKE_WAREHOUSE=UAT_WAREHOUSE
SNOWFLAKE_ROLE=UAT_ROLE

# Databricks Configuration (UAT)
DATABRICKS_HOST=https://uat-workspace.cloud.databricks.com
DATABRICKS_TOKEN=your-uat-databricks-token
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/uat-warehouse-id

# Application Under Test (UAT)
APP_BASE_URL=https://uat.your-app.com
APP_API_BASE_URL=https://uat-api.your-app.com
APP_USERNAME=uat-test-user
APP_PASSWORD=uat-test-password

# Agent Configuration
AGENT_LOG_LEVEL=info
AGENT_MAX_HEAL_ATTEMPTS=3
AGENT_LOCATOR_SIMILARITY_THRESHOLD=0.7
AGENT_AUTO_COMMIT_FIXES=false

# Reporting
REPORT_OUTPUT_DIR=./reports/uat
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=true
