# ========================================================
# Base .env template
# ========================================================
# This file is loaded as the fallback when no environment-specific
# file is found.  For multi-environment usage, copy this to:
#
#   .env.dev   .env.uat   .env.buat   .env.prod
#
# then set TEST_ENV below (or pass it via CLI / CI):
#
#   TEST_ENV=uat npm test
#   TEST_ENV=prod npm run orchestrate
# ========================================================

# Active environment: dev | uat | buat | prod
TEST_ENV=dev

# Jira Configuration
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=PROJ
JIRA_AUTO_FIELD=customfield_10100

# Snowflake Configuration
SNOWFLAKE_ACCOUNT=your-account
SNOWFLAKE_USERNAME=your-username
SNOWFLAKE_PASSWORD=your-password
SNOWFLAKE_DATABASE=your-database
SNOWFLAKE_SCHEMA=your-schema
SNOWFLAKE_WAREHOUSE=your-warehouse
SNOWFLAKE_ROLE=your-role

# Databricks Configuration
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=your-databricks-token
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id

# Application Under Test
APP_BASE_URL=https://your-app.com
APP_API_BASE_URL=https://api.your-app.com
APP_USERNAME=test-user
APP_PASSWORD=test-password

# Agent Configuration
AGENT_LOG_LEVEL=info
AGENT_MAX_HEAL_ATTEMPTS=3
AGENT_LOCATOR_SIMILARITY_THRESHOLD=0.7
AGENT_AUTO_COMMIT_FIXES=false

# Reporting
REPORT_OUTPUT_DIR=./reports
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=true
