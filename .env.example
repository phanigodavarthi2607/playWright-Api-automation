# =========================================================
# Copy this file to one of:
#   .env.dev   .env.uat   .env.buat
# The framework picks the right one based on TEST_ENV.
# =========================================================

# Base URLs
API_BASE_URL=https://api.dev.example.com
AUTH_BASE_URL=https://auth.dev.example.com

# Auth (SM_SESSION)
# The login endpoint that returns the SM_SESSION cookie/token
AUTH_LOGIN_PATH=/siteminder/login
AUTH_USERNAME=changeme
AUTH_PASSWORD=changeme
# Optional: if your org issues a long-lived SM_SESSION, you can paste it here
# to skip the login call. Leave blank to force a real login.
SM_SESSION=

# Request defaults
REQUEST_TIMEOUT_MS=30000
RETRY_COUNT=1

# Databricks (only required if you run @db tests against Databricks)
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=

# Snowflake (only required if you run @db tests against Snowflake)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USERNAME=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=

# Behaviour flags
UPDATE_BASELINES=false
LOG_LEVEL=info
