# Environment: buat
# Copy this file to .env.buat and fill in your BUAT environment values

TEST_ENV=buat

# Jira Configuration
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=PROJ
JIRA_AUTO_FIELD=customfield_10100

# Snowflake Configuration (BUAT)
SNOWFLAKE_ACCOUNT=your-buat-account
SNOWFLAKE_USERNAME=your-buat-username
SNOWFLAKE_PASSWORD=your-buat-password
SNOWFLAKE_DATABASE=BUAT_DATABASE
SNOWFLAKE_SCHEMA=BUAT_SCHEMA
SNOWFLAKE_WAREHOUSE=BUAT_WAREHOUSE
SNOWFLAKE_ROLE=BUAT_ROLE

# Databricks Configuration (BUAT)
DATABRICKS_HOST=https://buat-workspace.cloud.databricks.com
DATABRICKS_TOKEN=your-buat-databricks-token
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/buat-warehouse-id

# Application Under Test (BUAT)
APP_BASE_URL=https://buat.your-app.com
APP_API_BASE_URL=https://buat-api.your-app.com
APP_USERNAME=buat-test-user
APP_PASSWORD=buat-test-password

# Agent Configuration
AGENT_LOG_LEVEL=info
AGENT_MAX_HEAL_ATTEMPTS=3
AGENT_LOCATOR_SIMILARITY_THRESHOLD=0.7
AGENT_AUTO_COMMIT_FIXES=false

# Reporting
REPORT_OUTPUT_DIR=./reports/buat
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=true
