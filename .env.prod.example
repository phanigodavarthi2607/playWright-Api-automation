# Environment: prod
# Copy this file to .env.prod and fill in your production environment values
# WARNING: Use read-only test accounts. Never run destructive tests against prod.

TEST_ENV=prod

# Jira Configuration
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=PROJ
JIRA_AUTO_FIELD=customfield_10100

# Snowflake Configuration (Prod - READ ONLY)
SNOWFLAKE_ACCOUNT=your-prod-account
SNOWFLAKE_USERNAME=your-prod-readonly-username
SNOWFLAKE_PASSWORD=your-prod-readonly-password
SNOWFLAKE_DATABASE=PROD_DATABASE
SNOWFLAKE_SCHEMA=PROD_SCHEMA
SNOWFLAKE_WAREHOUSE=PROD_WAREHOUSE
SNOWFLAKE_ROLE=PROD_READ_ROLE

# Databricks Configuration (Prod - READ ONLY)
DATABRICKS_HOST=https://prod-workspace.cloud.databricks.com
DATABRICKS_TOKEN=your-prod-readonly-databricks-token
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/prod-warehouse-id

# Application Under Test (Prod)
APP_BASE_URL=https://your-app.com
APP_API_BASE_URL=https://api.your-app.com
APP_USERNAME=prod-readonly-test-user
APP_PASSWORD=prod-readonly-test-password

# Agent Configuration
AGENT_LOG_LEVEL=warn
AGENT_MAX_HEAL_ATTEMPTS=1
AGENT_LOCATOR_SIMILARITY_THRESHOLD=0.9
AGENT_AUTO_COMMIT_FIXES=false

# Reporting
REPORT_OUTPUT_DIR=./reports/prod
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=false
